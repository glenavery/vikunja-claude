# Copy to .env and fill in the token. .env is gitignored.
# Everything except VIKUNJA_API_TOKEN already defaults to these values.

VIKUNJA_API_TOKEN=

VIKUNJA_API_URL=http://127.0.0.1:3456/api/v1
VIKUNJA_FRONTEND_URL=http://127.0.0.1:3456
VIKUNJA_PROJECT=AI Alpha Engine

# Where Claude Code is launched, and how.
CLAUDE_WORKDIR=/home/glen/stacks/investment
CLAUDE_BIN=claude
# Unattended runs also need to run tests and commit — see "Permissions" in the
# README before loosening this.
CLAUDE_ARGS=-p --permission-mode acceptEdits
CLAUDE_LAUNCH_TIMEOUT_SECONDS=10800

# Loopback only. The service refuses to bind anywhere else.
VIKUNJA_CLAUDE_HOST=127.0.0.1
VIKUNJA_CLAUDE_PORT=3460
