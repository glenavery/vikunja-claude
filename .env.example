# Copy to .env and fill in the token. .env is gitignored.
# Everything except VIKUNJA_API_TOKEN already defaults to these values.

VIKUNJA_API_TOKEN=

VIKUNJA_API_URL=http://127.0.0.1:3456/api/v1
VIKUNJA_FRONTEND_URL=http://127.0.0.1:3456
VIKUNJA_PROJECT=AI Alpha Engine

# Where Claude Code is launched, and how.
CLAUDE_WORKDIR=/home/glen/stacks/investment
CLAUDE_BIN=claude
# Unattended runs also need to run tests and commit — see "Permissions" in the
# README before loosening this.
CLAUDE_ARGS=-p --permission-mode acceptEdits
CLAUDE_LAUNCH_TIMEOUT_SECONDS=10800

# Which model a run drives when the request does not name one.
#   claude  Claude Code as installed, talking to whatever it normally does.
#   local   the approved local coding seat, read from deploy/ollama/models.json
#           in CLAUDE_WORKDIR. Nothing here names a model.
# Per run, the console's "(local model)" buttons and ?executor=local on any of
# the /work routes select it. See "Which model a run drives" in the README.
RUNNER_EXECUTOR=claude

# Where the local executor points Claude Code: the transport shim, NOT Ollama
# itself, which refuses the trailing system message Claude Code always sends.
# Install it from deploy/ollama/ in the investment repository.
LOCAL_EXECUTOR_BASE_URL=http://127.0.0.1:11440

# Loopback only. The service refuses to bind anywhere else.
VIKUNJA_CLAUDE_HOST=127.0.0.1
VIKUNJA_CLAUDE_PORT=3460

# --- MCP boundary for ChatGPT (separate unit, separate port) ---------------
# Only needed if you run vikunja-claude-mcp.service. The launcher does not read
# these, and the MCP server refuses to start without the two below -- there is
# no unauthenticated mode.
#
# The public HTTPS base URL clients reach this server on; the OAuth metadata
# documents are published under it.
VIKUNJA_MCP_OAUTH_ISSUER=
# What proves an authorization request is yours. At least 32 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
VIKUNJA_MCP_OAUTH_PASSPHRASE=

# Loopback only, same as above. Tailscale Funnel publishes it over TLS.
VIKUNJA_MCP_HOST=127.0.0.1
VIKUNJA_MCP_PORT=3461

# --- Operational reads of the AI Server (optional) --------------------------
# Both or neither. Unset, the three operational tools are not advertised at all;
# setting only one is a refusal to start. Must be the ADMIN instance -- the
# endpoints do not exist on the public one. Plain http is accepted only to
# loopback or a Tailscale address. See "Operational reads" in the README.
INVESTMENT_API_URL=
INVESTMENT_API_KEY=
