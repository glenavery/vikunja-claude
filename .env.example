# Copy to .env and fill in the token. .env is gitignored.
# Everything except VIKUNJA_API_TOKEN already defaults to these values.

VIKUNJA_API_TOKEN=

VIKUNJA_API_URL=http://127.0.0.1:3456/api/v1
VIKUNJA_FRONTEND_URL=http://127.0.0.1:3456
VIKUNJA_PROJECT=AI Alpha Engine

# Where a run is launched, and how the default (claude) harness is invoked.
CLAUDE_WORKDIR=/home/glen/stacks/investment
CLAUDE_BIN=claude
# Unattended runs also need to run tests and commit — see "Permissions" in the
# README before loosening this. Keep --verbose --output-format stream-json:
# without them a run prints once, at the end, and get_task_run_status can only
# say that it started (task 755). This file is read by the service unit, so a
# CLAUDE_ARGS here overrides DEFAULT_CLAUDE_ARGS in config.py entirely.
CLAUDE_ARGS=-p --verbose --output-format stream-json --permission-mode acceptEdits
CLAUDE_LAUNCH_TIMEOUT_SECONDS=10800
# How long a run that hit that limit is given to die, per signal: SIGTERM, this
# long, SIGKILL, this long again. Then the ending is recorded and the lock
# released. Not a second time limit — it only bounds the kill.
CLAUDE_KILL_GRACE_SECONDS=30

# The local executor's harness. `local` means OpenCode driving the approved
# local seat — not Claude Code on a different model (task 810).
# Must be resolvable on the SERVICE's PATH, which is not your shell's: the unit
# runs with ~/.local/bin:/usr/local/bin:/usr/bin:/bin, and an npm-global install
# puts opencode in ~/.npm-global/bin. Symlink it beside claude in ~/.local/bin,
# or give the absolute path here.
OPENCODE_BIN=opencode
# `run` is the headless subcommand and `--format json` its streaming output, the
# counterpart of --output-format stream-json above. `--auto` is what lets an
# unattended run carry out the commands the ticket needs — the tests, the
# commit, the vkctl.py report-back — inside the worktree the runner made for it;
# read "Permissions" in the README before changing it, and note that leaving it
# off does not park a run, it produces one that changes nothing. Overrides
# DEFAULT_OPENCODE_ARGS in config.py entirely. The seat is appended after this
# as --model, so a value here cannot choose the model.
OPENCODE_ARGS=run --format json --auto

# Which harness and model a run uses when the request does not name one.
#   claude  Claude Code as installed, talking to whatever it normally does.
#   local   OpenCode on the approved local coding seat, read from
#           deploy/ollama/models.json in CLAUDE_WORKDIR. Nothing here names a
#           model.
# Per run, the console's "(local model)" buttons and ?executor=local on any of
# the /work routes select it. See "Which harness a run uses" in the README.
RUNNER_EXECUTOR=claude

# Where the local executor reaches the seat: Ollama itself, on its
# OpenAI-compatible surface. OpenCode speaks that shape, so this path does NOT
# go through the Anthropic transport shim on :11440 that Claude Code needs —
# the shim is still deployed and still serves the claude executor.
LOCAL_EXECUTOR_BASE_URL=http://127.0.0.1:11434/v1

# Loopback only. The service refuses to bind anywhere else.
VIKUNJA_CLAUDE_HOST=127.0.0.1
VIKUNJA_CLAUDE_PORT=3460

# --- MCP boundary for ChatGPT (separate unit, separate port) ---------------
# Only needed if you run vikunja-claude-mcp.service. The launcher does not read
# these, and the MCP server refuses to start without the two below -- there is
# no unauthenticated mode.
#
# The public HTTPS base URL clients reach this server on; the OAuth metadata
# documents are published under it.
VIKUNJA_MCP_OAUTH_ISSUER=
# What proves an authorization request is yours. At least 32 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
VIKUNJA_MCP_OAUTH_PASSPHRASE=

# Loopback only, same as above. Tailscale Funnel publishes it over TLS.
VIKUNJA_MCP_HOST=127.0.0.1
VIKUNJA_MCP_PORT=3461

# --- Operational reads of the AI Server (optional) --------------------------
# Both or neither. Unset, the three operational tools are not advertised at all;
# setting only one is a refusal to start. Must be the ADMIN instance -- the
# endpoints do not exist on the public one. Plain http is accepted only to
# loopback or a Tailscale address. See "Operational reads" in the README.
INVESTMENT_API_URL=
INVESTMENT_API_KEY=
